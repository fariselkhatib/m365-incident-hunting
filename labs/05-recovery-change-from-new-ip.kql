let AuditLogs = datatable(TimeGenerated:datetime, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic) [
    datetime(2026-03-10T14:55:00Z), "Consent to application", "ApplicationManagement", "success", "", dynamic({"user":{"userPrincipalName":"dana@lab.example","ipAddress":"198.51.100.77"}}), dynamic([{"displayName":"Mail Sync Pro","id":"00000000-0000-0000-0000-00000000a001","modifiedProperties":[{"displayName":"ConsentContext.IsAdminConsent","newValue":"\"False\""},{"displayName":"ConsentAction.Permissions","newValue":"[] => [[ConsentType: Principal, Scope: Mail.ReadWrite offline_access User.Read, ]]"}]}]),
    datetime(2026-03-10T15:05:00Z), "User registered security info", "UserManagement", "success", "User registered Authenticator App with Notification and Code", dynamic({"user":{"userPrincipalName":"dana@lab.example","ipAddress":"198.51.100.77"}}), dynamic([{"displayName":"dana","userPrincipalName":"dana@lab.example","modifiedProperties":[]}]),
    datetime(2026-03-10T15:30:00Z), "Consent to application", "ApplicationManagement", "success", "", dynamic({"user":{"userPrincipalName":"ravi@lab.example","ipAddress":"203.0.113.10"}}), dynamic([{"displayName":"Zoom","id":"00000000-0000-0000-0000-00000000a002","modifiedProperties":[{"displayName":"ConsentContext.IsAdminConsent","newValue":"\"False\""},{"displayName":"ConsentAction.Permissions","newValue":"[] => [[ConsentType: Principal, Scope: User.Read openid profile email, ]]"}]}]),
    datetime(2026-03-10T15:45:00Z), "User registered security info", "UserManagement", "success", "User registered Mobile Phone SMS", dynamic({"user":{"userPrincipalName":"ravi@lab.example","ipAddress":"203.0.113.10"}}), dynamic([{"displayName":"ravi","userPrincipalName":"ravi@lab.example","modifiedProperties":[]}])
];

let query_end = datetime(2026-03-11T00:00:00Z);
let lookback = 1d;
let baseline = 14d;
let recovery_ops = dynamic(["User registered security info", "User changed default security info",
                            "User deleted security info", "Admin registered security info",
                            "Admin updated security info", "Admin deleted security info",
                            "Reset password (self-service)", "Reset user password",
                            "Change user password"]);
let known_ips = SigninLogs
    | where TimeGenerated between ((query_end - lookback - baseline) .. (query_end - lookback))
    | where ResultType == "0"
    | extend KnownUser = tolower(UserPrincipalName)
    | distinct KnownUser, IPAddress;
AuditLogs
| where TimeGenerated between ((query_end - lookback) .. query_end)
| where OperationName in (recovery_ops)
| extend Target = tolower(tostring(TargetResources[0].userPrincipalName)),
         Actor = tostring(InitiatedBy.user.userPrincipalName),
         ActorIP = tostring(InitiatedBy.user.ipAddress)
| join kind=leftanti known_ips on $left.Target == $right.KnownUser, $left.ActorIP == $right.IPAddress
| project TimeGenerated, OperationName, Target, Actor, ActorIP, Result, ResultReason
| order by TimeGenerated asc
