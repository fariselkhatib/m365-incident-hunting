    datetime(2026-03-10T13:30:00Z), "ravi@lab.example", "203.0.113.10", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T13:45:00Z), "mlee@lab.example", "203.0.113.20", "50126", "Invalid username or password", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T13:46:00Z), "mlee@lab.example", "203.0.113.20", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T14:00:15Z), "alex@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:02:15Z), "bea@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
