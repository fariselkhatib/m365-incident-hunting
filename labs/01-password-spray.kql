// LAB VERSION of queries/01-password-spray.kql. Generated by tools/build_labs.py; do not edit.
// Synthetic data only. now() is pinned to datetime(2026-03-11T00:00:00Z).
// Title: Password spray from a single IP, with any follow-on success
// Description: Finds source IPs that failed authentication against many distinct accounts
//   in the window, then checks whether that same IP later got a successful sign-in.
//   A spray that ends in a success is the row you want at the top of your queue.
// Tables: SigninLogs
// MITRE: T1110.003, T1078.004
// False positives: Shared egress (corporate NAT, VPN concentrators, cloud proxies) can push
//   many users' typos through one IP. Misconfigured service apps retrying stale creds.
//   Check whether the IP belongs to your org before escalating.
// Tuning: Raise min_users for large tenants. Exclude known egress IPs with a watchlist.
//   ResultType 50126 = invalid username/password, 50053 = account locked.
// Expected lab results: 1 row. 198.51.100.77, 8 targeted users, SprayLikelySucceeded = true
//   (dana@lab.example).

let SigninLogs = datatable(TimeGenerated:datetime, UserPrincipalName:string, IPAddress:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, LocationDetails:dynamic) [
    datetime(2026-03-01T15:10:00Z), "dana@lab.example", "203.0.113.10", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-01T15:40:00Z), "ravi@lab.example", "203.0.113.10", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-02T16:05:00Z), "mlee@lab.example", "203.0.113.20", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T13:00:00Z), "dana@lab.example", "203.0.113.10", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T13:30:00Z), "ravi@lab.example", "203.0.113.10", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T13:45:00Z), "mlee@lab.example", "203.0.113.20", "50126", "Invalid username or password", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T13:46:00Z), "mlee@lab.example", "203.0.113.20", "0", "", "Office 365 Exchange Online", "Microsoft Office/16.0 (Windows NT 10.0; Microsoft Outlook 16.0)", dynamic({"countryOrRegion":"US","city":"Houston"}),
    datetime(2026-03-10T14:00:15Z), "alex@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:02:15Z), "bea@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:04:15Z), "chris@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:06:15Z), "dana@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:08:15Z), "eli@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:10:15Z), "faye@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:12:15Z), "gus@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:14:15Z), "hana@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:16:40Z), "dana@lab.example", "198.51.100.77", "50126", "Invalid username or password", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"}),
    datetime(2026-03-10T14:22:00Z), "dana@lab.example", "198.51.100.77", "0", "", "OfficeHome", "python-requests/2.31.0", dynamic({"countryOrRegion":"NL","city":"Amsterdam"})
];

let query_end = datetime(2026-03-11T00:00:00Z);
let lookback = 1d;
let min_users = 5;
let window_signins = SigninLogs
    | where TimeGenerated between ((query_end - lookback) .. query_end);
window_signins
| where ResultType in ("50126", "50053")
| summarize FailedUsers = dcount(UserPrincipalName),
            FailedAttempts = count(),
            FirstFail = min(TimeGenerated),
            LastFail = max(TimeGenerated),
            TargetedUsers = make_set(UserPrincipalName, 100)
    by IPAddress
| where FailedUsers >= min_users
| join kind=leftouter (
    window_signins
    | where ResultType == "0"
    | summarize SuccessUsers = make_set(UserPrincipalName, 100),
                FirstSuccess = min(TimeGenerated)
        by IPAddress
  ) on IPAddress
| extend SprayLikelySucceeded = coalesce(array_length(SuccessUsers), 0) > 0
| project IPAddress, FailedUsers, FailedAttempts, FirstFail, LastFail,
          SprayLikelySucceeded, SuccessUsers, FirstSuccess, TargetedUsers
| order by SprayLikelySucceeded desc, FailedUsers desc
