let OfficeActivity = datatable(TimeGenerated:datetime, UserId:string, ClientIP:string, Operation:string, OfficeWorkload:string, ResultStatus:string, Parameters:string) [
    datetime(2026-03-10T14:40:00Z), "dana@lab.example", "198.51.100.77", "New-InboxRule", "Exchange", "True", "[{\"Name\": \"Name\", \"Value\": \".\"}, {\"Name\": \"SubjectOrBodyContainsWords\", \"Value\": \"invoice;payment;wire\"}, {\"Name\": \"MoveToFolder\", \"Value\": \"RSS Subscriptions\"}, {\"Name\": \"MarkAsRead\", \"Value\": \"True\"}, {\"Name\": \"StopProcessingRules\", \"Value\": \"True\"}]",
    datetime(2026-03-10T15:20:00Z), "ravi@lab.example", "203.0.113.10", "New-InboxRule", "Exchange", "True", "[{\"Name\": \"Name\", \"Value\": \"Newsletters\"}, {\"Name\": \"From\", \"Value\": \"news@vendor.example\"}, {\"Name\": \"MoveToFolder\", \"Value\": \"Newsletters\"}, {\"Name\": \"StopProcessingRules\", \"Value\": \"False\"}]",
    datetime(2026-03-10T16:05:00Z), "mlee@lab.example", "203.0.113.20", "New-InboxRule", "Exchange", "True", "[{\"Name\": \"Name\", \"Value\": \"Fwd to personal\"}, {\"Name\": \"ForwardTo\", \"Value\": \"mlee.personal@mail.example\"}, {\"Name\": \"StopProcessingRules\", \"Value\": \"False\"}]"
];
let AuditLogs = datatable(TimeGenerated:datetime, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic) [
    datetime(2026-03-10T14:55:00Z), "Consent to application", "ApplicationManagement", "success", "", dynamic({"user":{"userPrincipalName":"dana@lab.example","ipAddress":"198.51.100.77"}}), dynamic([{"displayName":"Mail Sync Pro","id":"00000000-0000-0000-0000-00000000a001","modifiedProperties":[{"displayName":"ConsentContext.IsAdminConsent","newValue":"\"False\""},{"displayName":"ConsentAction.Permissions","newValue":"[] => [[ConsentType: Principal, Scope: Mail.ReadWrite offline_access User.Read, ]]"}]}]),
    datetime(2026-03-10T15:05:00Z), "User registered security info", "UserManagement", "success", "User registered Authenticator App with Notification and Code", dynamic({"user":{"userPrincipalName":"dana@lab.example","ipAddress":"198.51.100.77"}}), dynamic([{"displayName":"dana","userPrincipalName":"dana@lab.example","modifiedProperties":[]}]),
    datetime(2026-03-10T15:30:00Z), "Consent to application", "ApplicationManagement", "success", "", dynamic({"user":{"userPrincipalName":"ravi@lab.example","ipAddress":"203.0.113.10"}}), dynamic([{"displayName":"Zoom","id":"00000000-0000-0000-0000-00000000a002","modifiedProperties":[{"displayName":"ConsentContext.IsAdminConsent","newValue":"\"False\""},{"displayName":"ConsentAction.Permissions","newValue":"[] => [[ConsentType: Principal, Scope: User.Read openid profile email, ]]"}]}]),
    datetime(2026-03-10T15:45:00Z), "User registered security info", "UserManagement", "success", "User registered Mobile Phone SMS", dynamic({"user":{"userPrincipalName":"ravi@lab.example","ipAddress":"203.0.113.10"}}), dynamic([{"displayName":"ravi","userPrincipalName":"ravi@lab.example","modifiedProperties":[]}])
];

let query_end = datetime(2026-03-11T00:00:00Z);
let lookback = 1d;
let baseline = 14d;
let seq_window = 4h;
let known_ips = SigninLogs
    | where TimeGenerated between ((query_end - lookback - baseline) .. (query_end - lookback))
    | where ResultType == "0"
    | extend KnownUser = tolower(UserPrincipalName)
    | distinct KnownUser, IPAddress;
let new_ip_signins = SigninLogs
    | where TimeGenerated between ((query_end - lookback) .. query_end)
    | where ResultType == "0"
    | extend User = tolower(UserPrincipalName)
    | join kind=leftanti known_ips on $left.User == $right.KnownUser, $left.IPAddress == $right.IPAddress
    | project TimeGenerated, User, Signal = "new-ip-signin",
              Detail = strcat(IPAddress, " (", tostring(LocationDetails.countryOrRegion), ")");
let inbox_rules = OfficeActivity
    | where TimeGenerated between ((query_end - lookback) .. query_end)
    | where Operation in~ ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules")
    | project TimeGenerated, User = tolower(UserId), Signal = "inbox-rule",
              Detail = strcat(Operation, " from ", ClientIP);
let consents = AuditLogs
    | where TimeGenerated between ((query_end - lookback) .. query_end)
    | where OperationName == "Consent to application"
    | project TimeGenerated, User = tolower(tostring(InitiatedBy.user.userPrincipalName)),
              Signal = "oauth-consent", Detail = tostring(TargetResources[0].displayName);
let recovery_changes = AuditLogs
    | where TimeGenerated between ((query_end - lookback) .. query_end)
    | where OperationName has "security info"
    | project TimeGenerated, User = tolower(tostring(TargetResources[0].userPrincipalName)),
              Signal = "security-info-change", Detail = OperationName;
union new_ip_signins, inbox_rules, consents, recovery_changes
| order by TimeGenerated asc
| summarize FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated),
            Signals = make_set(Signal),
            Sequence = make_list(bag_pack("time", TimeGenerated, "signal", Signal, "detail", Detail))
    by User
| extend SignalCount = array_length(Signals), SpanMinutes = datetime_diff('minute', LastSeen, FirstSeen)
| where Signals has "new-ip-signin" and SignalCount >= 3 and LastSeen - FirstSeen <= seq_window
| project User, SignalCount, SpanMinutes, FirstSeen, LastSeen, Signals, Sequence
| order by SignalCount desc
