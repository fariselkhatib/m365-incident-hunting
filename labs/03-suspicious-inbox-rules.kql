// LAB VERSION of queries/03-suspicious-inbox-rules.kql. Generated by tools/build_labs.py; do not edit.
// Synthetic data only. now() is pinned to datetime(2026-03-11T00:00:00Z).
// Title: Suspicious inbox rules (BEC hiding and forwarding patterns)
// Description: Scores new or modified inbox rules on the traits attackers use after taking
//   over a mailbox: forwarding outside the org, deleting or burying mail in folders nobody
//   checks, keyword filters for finance and security terms, throwaway rule names, and
//   auto mark-as-read.
// Tables: OfficeActivity
// MITRE: T1564.008, T1114.003
// False positives: Users forwarding to a personal address (still a policy issue, rarely a
//   compromise). Legit filters that move vendor invoices to a folder. Helpdesk scripts that
//   create rules in bulk.
// Tuning: Set internal_domains to every accepted domain in the tenant. Adjust weights in
//   Score. Lower the threshold to 2 when hunting, keep 3+ for alerting.
// Expected lab results: 2 rows. dana@lab.example rule "." (score 6: hides mail, lure
//   keywords, obscure name, marks read). mlee@lab.example external forward (score 3, likely
//   a policy violation, not a compromise). ravi@lab.example's newsletter rule is not returned.

let OfficeActivity = datatable(TimeGenerated:datetime, UserId:string, ClientIP:string, Operation:string, OfficeWorkload:string, ResultStatus:string, Parameters:string) [
    datetime(2026-03-10T14:40:00Z), "dana@lab.example", "198.51.100.77", "New-InboxRule", "Exchange", "True", "[{\"Name\": \"Name\", \"Value\": \".\"}, {\"Name\": \"SubjectOrBodyContainsWords\", \"Value\": \"invoice;payment;wire\"}, {\"Name\": \"MoveToFolder\", \"Value\": \"RSS Subscriptions\"}, {\"Name\": \"MarkAsRead\", \"Value\": \"True\"}, {\"Name\": \"StopProcessingRules\", \"Value\": \"True\"}]",
    datetime(2026-03-10T15:20:00Z), "ravi@lab.example", "203.0.113.10", "New-InboxRule", "Exchange", "True", "[{\"Name\": \"Name\", \"Value\": \"Newsletters\"}, {\"Name\": \"From\", \"Value\": \"news@vendor.example\"}, {\"Name\": \"MoveToFolder\", \"Value\": \"Newsletters\"}, {\"Name\": \"StopProcessingRules\", \"Value\": \"False\"}]",
    datetime(2026-03-10T16:05:00Z), "mlee@lab.example", "203.0.113.20", "New-InboxRule", "Exchange", "True", "[{\"Name\": \"Name\", \"Value\": \"Fwd to personal\"}, {\"Name\": \"ForwardTo\", \"Value\": \"mlee.personal@mail.example\"}, {\"Name\": \"StopProcessingRules\", \"Value\": \"False\"}]"
];

let query_end = datetime(2026-03-11T00:00:00Z);
let lookback = 1d;
let internal_domains = dynamic(["lab.example"]);
let lure_words = dynamic(["invoice", "payment", "wire", "bank", "ach", "remit", "password",
                          "security", "phish", "hack", "compromise", "fraud"]);
let hidden_folder_regex = @"(?i)(rss|conversation history|archive|junk|deleted items)";
OfficeActivity
| where TimeGenerated between ((query_end - lookback) .. query_end)
| where OfficeWorkload == "Exchange"
| where Operation in~ ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules")
| mv-apply p = todynamic(Parameters) on (
    summarize RuleParams = make_bag(bag_pack(tostring(p.Name), tostring(p.Value)))
  )
| extend RuleName = tostring(RuleParams.Name),
         ForwardTo = strcat(tostring(RuleParams.ForwardTo), ";",
                            tostring(RuleParams.ForwardAsAttachmentTo), ";",
                            tostring(RuleParams.RedirectTo)),
         MoveTo = tostring(RuleParams.MoveToFolder),
         Deletes = coalesce(tobool(RuleParams.DeleteMessage), false),
         MarkRead = coalesce(tobool(RuleParams.MarkAsRead), false),
         Keywords = strcat(tostring(RuleParams.SubjectContainsWords), ";",
                           tostring(RuleParams.SubjectOrBodyContainsWords), ";",
                           tostring(RuleParams.BodyContainsWords))
| extend ExternalDomains = set_difference(
             extract_all(@"@([a-z0-9.\-]+)", tolower(ForwardTo)), internal_domains)
| extend ForwardsExternal = array_length(ExternalDomains) > 0,
         HidesMail = Deletes or MoveTo matches regex hidden_folder_regex,
         LureKeywords = Keywords has_any (lure_words),
         ObscureName = strlen(trim(@"\s+", RuleName)) <= 2 or RuleName matches regex @"^[\W_]+$"
| extend Score = toint(ForwardsExternal) * 3 + toint(HidesMail) * 2 + toint(LureKeywords) * 2
               + toint(ObscureName) + toint(MarkRead)
| where Score >= 3
| project TimeGenerated, UserId, ClientIP, Operation, RuleName, Score, ForwardsExternal,
          ExternalDomains, HidesMail, MoveTo, LureKeywords, Keywords, ObscureName, MarkRead
| order by Score desc
